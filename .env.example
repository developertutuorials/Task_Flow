# Database Configuration (Neon or PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk Authentication (Used by API Gateway)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Email & Notification Settings (Brevo / Nodemailer)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SENDER_EMAIL=noreply@taskflow.dev

# Microservices Ports & URLs
GATEWAY_PORT=4000
WORKSPACE_SERVICE_URL=http://localhost:5001
PROJECT_SERVICE_URL=http://localhost:5002
TASK_SERVICE_URL=http://localhost:5003
NOTIFICATION_SERVICE_URL=http://localhost:5004
USER_SERVICE_URL=http://localhost:5005

# Redis (Optional in local dev, recommended for production pub/sub)
REDIS_URL=redis://localhost:6379

